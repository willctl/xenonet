{
  "name": "xenonet",
  "productName": "XenoNet",
  "version": "0.3.0",
  "private": true,
  "description": "The network for SI. See every Claude Code and Codex session on your machine on one live map. Sessions can message each other, claim files before editing, and wake agents running elsewhere.",
  "author": "willctl",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --watch --dev",
    "demo": "node scripts/serve.mjs --watch --dev --demo",
    "build": "vite build",
    "start": "vite build && node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node scripts/rust-bin.mjs && node --test --test-concurrency=1 \"test/e2e/*.test.js\"",
    "test:real": "node --test --test-concurrency=1 \"test/real/*.test.js\"",
    "test:rust": "node scripts/rust-parity.mjs",
    "test:bin": "node scripts/rust-bin-tests.mjs",
    "cargo": "node scripts/cargo.mjs",
    "lint:rust": "node scripts/rust-lint.mjs",
    "coverage:rust": "node scripts/rust-coverage.mjs",
    "rust:build": "node scripts/rust-build.mjs",
    "rust:bin": "node scripts/rust-bin.mjs",
    "drive": "node cli/xenonet.js console",
    "contracts": "node scripts/check-contracts.mjs",
    "provider-drift": "node scripts/provider-drift.mjs",
    "schemas": "node scripts/schemas.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:gpu": "node scripts/gpu-bench.mjs",
    "lab": "node scripts/lab/lab.mjs",
    "hook:snippet": "node scripts/hook-snippet.mjs",
    "app": "node scripts/rust-bin.mjs && electron .",
    "app:prod": "vite build && node scripts/rust-bin.mjs && electron . --prod",
    "dev:install": "node scripts/rust-bin.mjs && node scripts/dev-install.mjs",
    "icon": "electron . --make-icons build",
    "dist": "node scripts/dist.mjs",
    "dist:win": "node scripts/dist.mjs win",
    "dist:mac": "node scripts/dist.mjs mac",
    "dist:dir": "node scripts/dist.mjs dir",
    "shortcut": "release\\win-unpacked\\XenoNet.exe --install-shortcut",
    "release:check": "node scripts/release.mjs check",
    "version": "node scripts/release.mjs plugin",
    "release:build": "node scripts/release-build.mjs",
    "release:verify": "node scripts/release.mjs verify"
  },
  "main": "electron/main.js",
  "bin": {
    "xenonet": "cli/xenonet.js"
  },
  "build": {
    "appId": "dev.xenonet.app",
    "productName": "XenoNet",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "core/**",
      "server/**",
      "mcp/**",
      "cli/**",
      "dist/**",
      "schemas/**",
      "package.json",
      "!**/node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asar": false,
    "electronLanguages": [
      "en-US"
    ],
    "afterPack": "./scripts/builder-hooks.mjs",
    "afterSign": "./scripts/builder-hooks.mjs",
    "afterAllArtifactBuild": "./scripts/builder-hooks.mjs",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "pkg",
        "zip"
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "darkModeSupport": true,
      "minimumSystemVersion": "13.0",
      "electronLanguages": [
        "en"
      ],
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "XenoNet reads the projects and sessions you keep in Documents, and its terminal can work there.",
        "NSDesktopFolderUsageDescription": "XenoNet reads the projects and sessions you keep on the Desktop, and its terminal can work there.",
        "NSDownloadsFolderUsageDescription": "XenoNet's terminal can work in your Downloads folder.",
        "NSRemovableVolumesUsageDescription": "XenoNet reads projects you keep on external drives, and its terminal can work there.",
        "NSNetworkVolumesUsageDescription": "XenoNet reads projects you keep on network drives, and its terminal can work there.",
        "NSAppleEventsUsageDescription": "Commands you run in XenoNet's terminal can control other apps.",
        "NSLocalNetworkUsageDescription": "Commands you run in XenoNet's terminal can reach devices on your local network."
      }
    },
    "copyright": "Copyright © 2026 willctl",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "XenoNet",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh",
      "uninstallDisplayName": "XenoNet",
      "artifactName": "XenoNet-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "XenoNet ${version}",
      "icon": "build/icon.icns",
      "background": "build/dmgBackground.png",
      "iconSize": 112,
      "iconTextSize": 13,
      "contents": [
        {
          "x": 180,
          "y": 210,
          "type": "file"
        },
        {
          "x": 480,
          "y": 210,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "format": "ULFO",
      "artifactName": "XenoNet-${version}-${arch}.${ext}"
    },
    "pkg": {
      "artifactName": "XenoNet-${version}-${arch}.${ext}",
      "identity": null,
      "isRelocatable": false,
      "isVersionChecked": true,
      "overwriteAction": "upgrade",
      "mustClose": [
        "dev.xenonet.app"
      ],
      "allowAnywhere": false,
      "allowCurrentUserHome": true,
      "allowRootDirectory": true,
      "welcome": "build/pkg/welcome.html",
      "conclusion": "build/pkg/conclusion.html",
      "background": {
        "file": "build/pkgBackground.png",
        "alignment": "bottomleft",
        "scaling": "none"
      }
    },
    "publish": [
      {
        "provider": "github",
        "owner": "willctl",
        "repo": "xenonet",
        "releaseType": "draft"
      }
    ],
    "compression": "maximum",
    "artifactName": "XenoNet-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.287",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "electron-updater": "6.8.10",
    "jevrouter": "file:vendor/jevrouter-0.1.0.tgz",
    "tar": "7.5.22",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "3d-force-graph": "^1.80.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "js-yaml": "4.3.2",
    "three": "^0.186.1",
    "three-spritetext": "^1.10.0",
    "vite": "^8.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/willctl/xenonet.git"
  },
  "homepage": "https://github.com/willctl/xenonet"
}
