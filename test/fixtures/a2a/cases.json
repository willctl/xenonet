{
  "about": "A2A 1.0's JSON-RPC binding at XenoNet's /a2a: requests written from the specification's examples (https://a2a-protocol.org/latest/specification/, sections 6, 8.5 and 9), each with XenoNet's answer. crates/xenonet-service/tests/a2a.rs sends them in order, as actor:wren, to a made-up engine whose session claude:x answers \"Today will be sunny with a high of 75°F\" to every message, and compares. In answers, $task and $context stand for the first task's id and context, $task2 for the streamed one's, and times are the test clock's.",
  "card": {
    "address": "https://gw.example.com",
    "name": "studio",
    "version": "0.2.0",
    "answer": {
      "name": "XenoNet on studio",
      "description": "Reach the coding sessions (Claude Code, Codex and others) that XenoNet connects here. Each A2A agent is an actor with its own token and scopes: it reaches only the sessions its user allowed, and a session's reply is the result of the agent's task.",
      "supportedInterfaces": [
        {
          "url": "https://gw.example.com/a2a",
          "protocolBinding": "JSONRPC",
          "protocolVersion": "1.0"
        }
      ],
      "version": "0.2.0",
      "documentationUrl": "https://github.com/willctl/xenonet/blob/main/docs/guide/actors.md#agents-that-speak-a2a",
      "capabilities": {
        "streaming": true,
        "pushNotifications": false,
        "extendedAgentCard": false
      },
      "securitySchemes": {
        "gateway": {
          "httpAuthSecurityScheme": {
            "scheme": "Bearer",
            "description": "A gateway token made in XenoNet's window for this agent, sent as Authorization: Bearer <token>"
          }
        }
      },
      "securityRequirements": [
        {
          "schemes": {
            "gateway": {
              "list": []
            }
          }
        }
      ],
      "defaultInputModes": ["text/plain"],
      "defaultOutputModes": ["text/plain"],
      "skills": [
        {
          "id": "message-session",
          "name": "Message a coding session",
          "description": "Sends your message to a session your scope allows, and the session's reply completes the task. Name the session in the message's metadata as \"target\": its id (claude:…, codex:…), or repo:<name> for the sessions in that repo. With no target, the message goes to your default target, or, in a context you used before, back to whoever answered last. A context is one XenoNet thread. Text parts only.",
          "tags": ["coding", "sessions", "messages", "claude-code", "codex"],
          "examples": [
            "{\"message\": {\"role\": \"ROLE_USER\", \"parts\": [{\"text\": \"Which branch has the login fix?\"}], \"metadata\": {\"target\": \"repo:atlas\"}}}",
            "Ask the session working on the docs site whether the build is green."
          ],
          "inputModes": ["text/plain"],
          "outputModes": ["text/plain"]
        }
      ]
    }
  },
  "cases": [
    {
      "name": "SendMessage, answered (6.1, 9.4.1)",
      "headers": {
        "A2A-Version": "1.0"
      },
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "SendMessage",
        "params": {
          "message": {
            "role": "ROLE_USER",
            "parts": [
              {
                "text": "What is the weather today?"
              }
            ],
            "messageId": "msg-uuid",
            "metadata": {
              "target": "claude:x"
            }
          }
        }
      },
      "status": 200,
      "answer": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {
          "task": {
            "id": "$task",
            "contextId": "$context",
            "status": {
              "state": "TASK_STATE_COMPLETED",
              "timestamp": "2026-10-20T16:05:45.678Z",
              "message": {
                "messageId": "msg_reply-103",
                "contextId": "$context",
                "taskId": "$task",
                "role": "ROLE_AGENT",
                "parts": [
                  {
                    "text": "Today will be sunny with a high of 75°F",
                    "mediaType": "text/plain"
                  }
                ],
                "metadata": {
                  "from": "claude:x",
                  "fromName": "Weather"
                }
              }
            },
            "artifacts": [
              {
                "artifactId": "reply-103",
                "name": "Reply from Weather",
                "parts": [
                  {
                    "text": "Today will be sunny with a high of 75°F",
                    "mediaType": "text/plain"
                  }
                ],
                "metadata": {
                  "from": "claude:x",
                  "fromName": "Weather"
                }
              }
            ],
            "history": [
              {
                "role": "ROLE_USER",
                "parts": [
                  {
                    "text": "What is the weather today?"
                  }
                ],
                "messageId": "msg-uuid",
                "metadata": {
                  "target": "claude:x"
                },
                "taskId": "$task",
                "contextId": "$context"
              },
              {
                "messageId": "msg_reply-103",
                "contextId": "$context",
                "taskId": "$task",
                "role": "ROLE_AGENT",
                "parts": [
                  {
                    "text": "Today will be sunny with a high of 75°F",
                    "mediaType": "text/plain"
                  }
                ],
                "metadata": {
                  "from": "claude:x",
                  "fromName": "Weather"
