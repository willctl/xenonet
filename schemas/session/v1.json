{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/session/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "Session",
  "description": "One run of a harness (a Claude Code session, a Codex thread, a Gemini CLI run…), as XenoNet lists it. The map's session nodes (graph/v1) are these with where they live and what they're doing added.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "<app>:<the app's own id>, the id the rest of XenoNet uses; another host's carry @<host>:",
      "pattern": "^(@[a-z][a-z0-9-]{1,31}:)?(antigravity|gemini-cli|devin-cli|kimi-code|qwen-code|openhands|opencode|openclaw|windsurf|copilot|factory|claude|cursor|vscode|auggie|cowork|codex|cline|goose|crush|junie|grok|kiro|kilo|amp|pi):."
    },
    "app": {
      "type": "string",
      "enum": [
        "claude",
        "codex",
        "grok",
        "gemini-cli",
        "cursor",
        "copilot",
        "vscode",
        "opencode",
        "openclaw",
        "antigravity",
        "factory",
        "devin-cli",
        "kimi-code",
        "pi",
        "qwen-code",
        "cline",
        "amp",
        "auggie",
        "kiro",
        "goose",
        "kilo",
        "openhands",
        "crush",
        "junie",
        "windsurf",
        "cowork"
      ]
    },
    "rawId": {
      "type": "string",
      "description": "The app's own id: the Agent SDK's session id, or Codex's thread id"
    },
    "title": {
      "type": "string"
    },
    "preview": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The first prompt, or Codex's preview"
    },
    "cwd": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Where it ran; a Claude desktop worktree session gives the folder it branched from"
    },
    "createdAt": {
      "anyOf": [
        {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        {
          "type": "null"
        }
      ]
    },
    "updatedAt": {
      "anyOf": [
        {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        {
          "type": "null"
        }
      ]
    },
    "archived": {
      "type": "boolean"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "branch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "parentId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "The session this one was spawned or forked from"
    },
    "parentKind": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "spawn",
            "fork",
            "subagent"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "effort": {
      "type": [
        "string",
        "null"
      ]
    },
    "desktopId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Claude desktop's own id for it, local_…"
    },
    "inDesktop": {
      "type": "boolean"
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ]
    },
    "starred": {
      "type": "boolean"
    },
    "permissionMode": {
      "type": [
        "string",
        "null"
      ]
    },
    "tag": {
      "type": [
        "string",
        "null"
      ]
    },
    "sizeBytes": {
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "claudeAccount": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "account": {
          "type": "string"
        },
        "org": {
          "type": "string"
        }
      },
      "required": [
        "account",
        "org"
      ],
      "description": "The Claude account and organization Claude desktop filed it under",
      "additionalProperties": {}
    },
    "status": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider": {
      "type": [
        "string",
        "null"
      ],
      "description": "The model provider, when it isn't your ChatGPT account's"
    },
    "origin": {
      "type": [
        "string",
        "null"
      ],
      "description": "The repo's origin remote"
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "description": "What started it: cli, vscode, exec, subAgent…"
    },
    "originator": {
      "type": [
        "string",
        "null"
      ]
    },
    "nativeProjectId": {
      "type": [
        "string",
        "null"
      ],
      "description": "The Codex desktop project it belongs to"
    },
    "agentNickname": {
      "type": [
        "string",
        "null"
      ]
    },
    "agentKind": {
      "type": [
        "string",
        "null"
      ],
      "description": "For a Codex sub-agent thread: spawned, or the kind of background work; for a Grok Build subagent, its type (general-purpose, explore…)"
    },
    "background": {
      "type": "boolean",
      "description": "Background work (codex exec, reviews, compaction) the map leaves out unless asked"
    },
    "observed": {
      "type": "string",
      "enum": [
        "numbat",
        "gateway"
      ],
      "description": "How XenoNet knows of it: numbat's event records, or an actor's report through the gateway"
    },
    "reportedBy": {
      "type": [
        "string",
        "null"
      ],
      "description": "The actor that reported it through the gateway"
    },
    "reader": {
      "type": "string",
      "enum": [
        "experimental"
      ],
      "description": "Read from the harness's own records by an experimental reader (core/native)"
    },
    "usage": {
      "type": "object",
      "properties": {
        "costUsd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the app totalled for the whole session, in USD; null where it doesn't say. Not XenoNet's estimate at API prices"
        },
        "tokens": {
          "type": "object",
          "properties": {
            "input": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reasoning": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cacheRead": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cacheWrite": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "input",
            "output",
            "reasoning",
            "cacheRead",
            "cacheWrite"
          ],
          "additionalProperties": {}
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "costUsd",
        "tokens",
        "provider",
        "model"
      ],
      "description": "Reported by the app's own records (OpenCode's session row), whole session",
      "additionalProperties": {}
    }
  },
  "required": [
    "id",
    "app",
    "rawId",
    "title",
    "preview",
    "cwd",
    "createdAt",
    "updatedAt",
    "archived",
    "model",
    "branch",
    "parentId",
    "parentKind"
  ],
  "additionalProperties": {}
}
