{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/engine/message/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "A message between agents",
  "description": "A message from one agent to another, to everyone in a repo (target repo:<name>) or to all (\"all\"), at most 4,000 characters.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "from": {
          "type": "string",
          "description": "An agent: claude:<session id>, codex:<thread id> or grok:<session id>, or an actor, actor:<slug>"
        },
        "target": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        "how": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "session",
                    "token",
                    "window",
                    "grant",
                    "gateway"
                  ]
                },
                {
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "How XenoNet knows who sent it (its envelope's method); null for one sent before XenoNet kept that"
        },
        "to": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "description": "An agent: claude:<session id>, codex:<thread id> or grok:<session id>, or an actor, actor:<slug>",
                "type": "string"
              },
              "seen": {
                "type": "boolean"
              },
              "host": {
                "description": "For an agent on another host: its host",
                "type": [
                  "string",
                  "null"
                ]
              },
              "receipt": {
                "description": "For an agent on another host: what its host last said of it (stored, held, delivered, seen or refused), or unread when it was stored there and no one read it in a week; null before it said",
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "seen"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "id",
        "from",
        "target",
        "text",
        "at",
        "to"
      ],
      "description": "In the console's snapshot, GET /api/engine/state",
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "from": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "An agent: claude:<session id>, codex:<thread id> or grok:<session id>, or an actor, actor:<slug>"
            },
            "title": {
              "type": "string"
            },
            "app": {
              "type": "string",
              "enum": [
                "claude",
                "codex",
                "grok",
                "actor"
              ]
            },
            "project": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "branch": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "title",
            "app",
            "project",
            "branch"
          ],
          "additionalProperties": {}
        },
        "to": {
          "type": "string",
          "description": "\"you\", or what it was sent to"
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        "replyTo": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "envelope": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "const": "message/envelope/v1"
            },
            "mid": {
              "type": "string"
            },
            "at": {
              "type": "number",
              "description": "Epoch milliseconds"
            },
            "sender": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "kind": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "agent",
                        "actor",
                        "you"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "product": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "name",
                "product"
              ],
              "additionalProperties": {}
            },
            "auth": {
              "type": "object",
              "properties": {
                "method": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "session",
                        "token",
                        "window",
                        "grant",
                        "gateway",
                        "host"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ],
                  "description": "How it proved who it is; host: another host of the network signed the frame that brought it"
                },
                "process": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "signed",
                        "checked",
                        "unchecked",
                        "n/a"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ],
                  "description": "What XenoNet saw of the program that sent it"
                },
                "attestation": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "unchecked",
                        "process-checked",
                        "harness-signed",
                        "n/a"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ],
                  "description": "How the agent was checked, as policy reads it"
                }
              },
              "required": [
                "method",
                "process",
                "attestation"
              ],
              "additionalProperties": {}
            },
            "client": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "exe": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "exe",
                    "name"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "null"
                }
              ],
              "description": "The program it came from, with the home folder as ~, when XenoNet saw it"
            },
            "transport": {
              "type": "string",
              "description": "this machine, tunnel, gateway, or network: from another host of a XenoNet network"
            },
            "host": {
              "type": "string",
              "description": "For transport network: the host it came from"
            },
            "original": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string"
                },
                "authority": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "person",
                        "token",
                        "machine"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "authority"
              ],
              "description": "For transport network: who sent it and what this host checked of it",
              "additionalProperties": {}
            },
            "hops": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "For transport network: the messages before it in its thread, across hosts"
            },
            "line": {
              "type": "string",
              "description": "The same in a sentence: verified: …"
            }
          },
          "required": [
            "schema",
            "mid",
            "at",
            "sender",
            "auth",
            "client",
            "transport",
            "line"
          ],
          "description": "How XenoNet knows who sent it; null for one sent before XenoNet kept that",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "text",
        "at",
        "replyTo"
      ],
      "description": "In an agent's inbox",
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "from": {
          "type": "string",
          "description": "An agent: claude:<session id>, codex:<thread id> or grok:<session id>, or an actor, actor:<slug>"
        },
        "to": {
          "type": "array",
          "items": {
            "description": "An agent: claude:<session id>, codex:<thread id> or grok:<session id>, or an actor, actor:<slug>",
            "type": "string"
          }
        },
        "target": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "ts": {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        "verified": {
          "type": "string",
          "description": "How XenoNet knows who sent it, in a sentence"
        },
        "attestation": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "unchecked",
                "process-checked",
                "harness-signed",
                "n/a"
              ]
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "target",
        "text",
        "ts"
      ],
      "description": "The agent-message event",
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sender": {
          "type": "string",
          "description": "An agent: claude:<session id>, codex:<thread id> or grok:<session id>, or an actor, actor:<slug>"
        },
        "target": {
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "For a message to a repo, the repo's git folder or project"
        },
        "body": {
          "type": "string"
        },
        "reply_to": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        "envelope": {
          "type": [
            "string",
            "null"
          ],
          "description": "How XenoNet knew who sent it, as message/envelope/v1 JSON (core/engine/attest.js); null before it kept that"
        },
        "host": {
          "type": [
            "string",
            "null"
          ],
          "description": "The host of a XenoNet network it came from; null for one made on this machine"
        },
        "mid": {
          "type": [
            "string",
            "null"
          ],
          "description": "Its id across the network (its envelope's mid), for one that went to or came from another host"
        }
      },
      "required": [
        "id",
        "sender",
        "target",
        "scope",
        "body",
        "reply_to",
        "created_at"
      ],
      "description": "As engine.sqlite keeps it",
      "additionalProperties": {}
    }
  ]
}
