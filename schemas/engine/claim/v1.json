{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/engine/claim/v1.json",
  "$comment": "Written by npm run schemas from core/schema. Change the definition there, not this file.",
  "title": "A claim",
  "description": "A file, folder or glob an agent has said it's working on, until a time.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "pattern": {
          "type": "string",
          "description": "An absolute path, a folder (ending in /) or a glob"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "until": {
          "type": "number",
          "description": "Epoch milliseconds"
        }
      },
      "required": [
        "pattern",
        "note",
        "until"
      ],
      "additionalProperties": {},
      "description": "A claim, as an agent's claims list it"
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "agent": {
          "type": "string",
          "description": "An agent: claude:<session id>, codex:<thread id> or grok:<session id>, or an actor, actor:<slug>"
        },
        "pattern": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        "expires_at": {
          "type": "number",
          "description": "Epoch milliseconds"
        }
      },
      "required": [
        "id",
        "agent",
        "pattern",
        "note",
        "created_at",
        "expires_at"
      ],
      "additionalProperties": {},
      "description": "As engine.sqlite keeps it"
    }
  ]
}
