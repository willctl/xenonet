  "$id": "https://xenonet.dev/schemas/system/v1.json",
  "$comment": "Written by npm run schemas from core/schema. Change the definition there, not this file.",
  "title": "A computer's load",
  "description": "What a computer running XenoNet is doing: its CPU, memory and GPUs now and lately, and what the parts are.",
  "type": "object",
  "properties": {
    "at": {
      "type": "number",
      "description": "Epoch milliseconds"
    },
    "platform": {
      "type": "string",
      "maxLength": 32
    },
    "arch": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 32
        },
        {
          "type": "null"
        }
      ]
    },
    "uptime": {
      "type": "number",
      "minimum": 0,
      "description": "Seconds since the computer started"
    },
    "cpu": {
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "threads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ghz": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "All of its threads, since the last reading"
        },
        "cores": {
          "description": "Each thread's use; left out of a reading from another machine",
          "maxItems": 1024,
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "A share, 0 to 1"
          }
        }
      },
      "required": [
        "model",
        "threads",
        "ghz",
        "usage"
      ],
      "additionalProperties": {}
    },
    "memory": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0,
          "description": "Bytes"
        },
        "used": {
          "type": "number",
          "minimum": 0,
          "description": "Bytes"
        }
      },
      "required": [
        "total",
        "used"
      ],
      "additionalProperties": {}
