{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/system/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "A computer's load",
  "description": "What a computer running XenoNet is doing: its CPU, memory and GPUs now and lately, and what the parts are.",
  "type": "object",
  "properties": {
    "at": {
      "type": "number",
      "description": "Epoch milliseconds"
    },
    "platform": {
      "type": "string",
      "maxLength": 32
    },
    "arch": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 32
    },
    "uptime": {
      "type": "number",
      "minimum": 0,
      "description": "Seconds since the computer started"
    },
    "cpu": {
      "type": "object",
      "properties": {
        "model": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "threads": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ghz": {
          "type": [
            "number",
            "null"
          ],
          "format": "double",
          "minimum": 0
        },
        "usage": {
          "type": "number",
          "maximum": 1,
          "description": "All of its threads, since the last reading",
          "minimum": 0
        },
        "cores": {
          "type": "array",
          "items": {
            "description": "A share, 0 to 1",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "description": "Each thread's use; left out of a reading from another machine",
          "maxItems": 1024
        }
      },
      "required": [
        "model",
        "threads",
        "ghz",
        "usage"
      ],
      "additionalProperties": {}
    },
    "memory": {
      "type": "object",
      "properties": {
        "total": {
          "type": "number",
          "minimum": 0,
          "description": "Bytes"
        },
        "used": {
          "type": "number",
          "minimum": 0,
          "description": "Bytes"
        }
      },
      "required": [
        "total",
        "used"
      ],
      "additionalProperties": {}
    },
    "gpus": {
      "type": "array",
