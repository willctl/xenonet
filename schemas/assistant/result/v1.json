{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/assistant/result/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "A remote actor's answer",
  "description": "What one of the six read-only tools of xenonet mcp assistant answers: who asked (request_id), from which device and grant revision, how fresh it is, and the data. Strict: nothing the contract doesn't name.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "xenonet.assistant.result.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^r_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "grant_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "description": "ISO 8601, UTC",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ],
      "description": "When what this says was last observed; never refreshed for a cached answer"
    },
    "served_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this answer was sent, which is not when it was observed",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "freshness": {
      "type": "string",
      "enum": [
        "live",
        "stale",
        "unknown"
      ]
    },
    "partial": {
      "type": "boolean"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "SOURCE_DEGRADED",
              "SOURCE_UNAVAILABLE",
              "LIST_CAPPED",
              "PAGE_REDUCED",
              "STATS_UNAVAILABLE",
              "SERVED_FROM_CACHE",
              "FIXTURE_DATA"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "claude",
              "codex",
              "grok"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "code"
        ]
      },
      "maxItems": 16
    },
    "data": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "const": "read_only"
            },
            "connection": {
              "type": "string",
              "enum": [
                "connected",
                "paused",
                "service_unavailable"
              ]
            },
            "assistant_api": {
              "type": "number",
              "const": 1
            },
            "service_version": {
              "type": "string",
              "maxLength": 32
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
