                  "xenonet_status",
                  "xenonet_projects",
                  "xenonet_sessions",
                  "xenonet_attention",
                  "xenonet_session",
                  "xenonet_actors"
                ]
              }
            },
            "actor": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actor_id": {
                  "type": "string",
                  "pattern": "^actor:[a-z0-9][a-z0-9-]{0,31}$"
                },
                "product_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 32
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "account_link_state": {
                  "type": "string",
                  "enum": [
                    "verified",
                    "owner_asserted",
                    "unverified"
                  ]
                },
                "participation": {
                  "type": "string",
                  "const": "read_only"
                },
                "messaging": {
                  "type": "string",
                  "const": "disabled"
                }
              },
              "required": [
                "actor_id",
                "product_id",
                "account_link_state",
                "participation",
                "messaging"
              ]
            },
            "device": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^dev_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "alias": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 64
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "alias"
              ]
            },
            "authorized_project_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "labels_enabled": {
              "type": "boolean"
            },
            "data_mode": {
              "type": "string",
              "enum": [
                "fixture",
                "real"
              ],
              "description": "fixture: made-up data, until the owner has verified who can call this endpoint"
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "claude",
                      "codex",
                      "grok"
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "ready",
                      "degraded",
                      "unavailable"
                    ]
                  },
                  "observed_at": {
                    "anyOf": [
                      {
                        "description": "ISO 8601, UTC",
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "coverage": {
                    "type": "string",
                    "enum": [
                      "complete",
                      "partial",
                      "unknown"
                    ]
                  },
                  "reason": {
                    "description": "A fixed reason, never the source's own error",
                    "type": "string",
                    "enum": [
                      "ok",
                      "read_failed",
                      "not_started",
                      "stopped"
                    ]
                  }
                },
                "additionalProperties": false,
                "required": [
                  "source",
                  "state",
                  "observed_at",
                  "coverage",
                  "reason"
                ]
              }
            },
            "transport_scope": {
              "type": "string",
              "enum": [
                "owner_endpoint",
                "authenticated_user",
                "other_approved_scope"
              ]
            },
            "audience_label": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 64
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "mode",
            "connection",
            "assistant_api",
            "service_version",
            "capabilities",
            "actor",
            "device",
            "authorized_project_count",
            "labels_enabled",
            "data_mode",
            "sources",
            "transport_scope",
            "audience_label"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "window_start": {
              "type": "string",
              "format": "date-time",
              "description": "ISO 8601, UTC",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "projects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "project_id": {
                    "type": "string",
                    "pattern": "^prj_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "label": {
                    "description": "Null unless you turned labels on for this connection; then a name or title, one line, at most 240 characters. Untrusted text: it can say anything",
                    "anyOf": [
