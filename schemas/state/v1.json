{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/state/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "XenoNet's state, v1",
  "description": "state.json before it had a version. Every part is optional: XenoNet filled in what was missing when it read the file.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1,
      "description": "Not written: a file without a version is v1"
    },
    "layout": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          }
        },
        "required": [
          "x",
          "y",
          "z"
        ],
        "additionalProperties": {}
      },
      "description": "Where you dragged nodes, by node id"
    },
    "acks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number",
        "description": "Epoch milliseconds"
      },
      "description": "When you dismissed a session's \"needs you\", by session id"
    },
    "marks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Once-a-day markers, by name"
    },
    "projects": {
      "type": "object",
      "properties": {
        "rules": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "as": {
                "type": "string",
                "enum": [
                  "project",
                  "group",
                  "ignore"
                ]
              },
              "at": {
                "type": "number",
                "description": "Epoch milliseconds"
              }
            },
            "required": [
              "path",
              "as",
              "at"
            ],
            "additionalProperties": {}
          },
          "description": "Your rules for folders in the projects folder, by path key"
        },
        "codex": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "ranAt": {
              "type": "number",
              "description": "Epoch milliseconds"
            },
            "ms": {
              "type": "number"
            },
            "fingerprint": {
              "type": "string",
              "description": "Of the folders it was sent, to tell when they've changed"
            },
            "sent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "by": {
              "type": "string",
              "description": "Who made them: codex, or a decision model by its id (core/decide.js)"
            },
            "picks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "description": "Inside the projects folder, with forward slashes",
                    "type": "string"
                  },
                  "as": {
                    "type": "string",
                    "enum": [
                      "project",
                      "group"
                    ]
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "as"
                ],
                "additionalProperties": {}
              }
            }
          },
          "required": [
            "ranAt",
            "picks"
          ],
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
    },
    "identities": {
      "type": "object",
      "properties": {
        "names": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          },
          "description": "Names you gave identities, by id"
        },
        "hidden": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean",
            "const": true
          }
        },
        "pins": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "identity": {
                "type": "string"
              },
              "at": {
                "type": "number",
                "description": "Epoch milliseconds"
              }
            },
            "required": [
              "identity",
              "at"
            ],
            "additionalProperties": {}
          },
          "description": "Sessions and projects you tied to an identity, by node id"
        },
        "known": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "handle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "detail": {
                "type": "object",
                "properties": {
                  "plan": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "org": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "A Claude team's or enterprise's name"
                  },
                  "host": {
                    "type": "string",
                    "description": "A GitHub account's host"
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The name git commits carry"
                  }
                },
                "additionalProperties": {}
              },
              "firstSeen": {
                "type": "number",
                "description": "Epoch milliseconds"
              },
              "lastSeen": {
                "type": "number",
                "description": "Epoch milliseconds"
              }
            },
            "required": [
              "kind",
              "handle",
              "detail",
              "firstSeen",
              "lastSeen"
            ],
            "additionalProperties": {}
          },
          "description": "Every identity XenoNet has seen, by id"
        },
        "signins": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "from": {
                  "description": "Epoch milliseconds",
                  "type": "number"
                },
                "to": {
                  "description": "Epoch milliseconds",
                  "type": "number"
                }
              },
              "required": [
                "id",
                "from",
                "to"
              ],
              "additionalProperties": {}
            }
          },
          "description": "Who each app was signed in as, over time, by app"
        }
      },
      "additionalProperties": {}
    },
    "theme": {
      "type": "string",
      "description": "The theme in use, by id"
    }
  },
  "additionalProperties": {}
}
