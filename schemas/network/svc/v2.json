{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/network/svc/v2.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "A head on a svc/2 stream",
  "description": "One stream per request between members of a network (xenonet/svc/2): a request to a service another host published, or the window's read of another machine's transcript, and the answer, each a head and then its body.",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "network/svc/v2"
        },
        "op": {
          "type": "string",
          "const": "request",
          "description": "From the calling host"
        },
        "network": {
          "type": "string",
          "pattern": "^net_[0-9a-f]{32}$",
          "description": "The network the service was published in: the connection carries it, and the caller is the member whose endpoint id the connection authenticated in its chain"
        },
        "id": {
          "type": "string",
          "pattern": "^svq_[0-9a-f]{32}$",
          "description": "The request, made at random by the calling host; its answer names it"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "description": "The service, as its host published it"
        },
        "method": {
          "type": "string",
          "pattern": "^[A-Z]{1,16}$",
          "description": "A host passes on GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS"
        },
        "path": {
          "type": "string",
          "description": "The path after /api/svc/<host>/<name>, with its query: the publishing host normalizes it and checks it against the paths it publishes",
          "maxLength": 4096
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "string",
                "maxLength": 8192
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "description": "Only the caller's Authorization, Content-Type, Accept and User-Agent cross; the publishing host adds Host and Forwarded itself",
          "maxItems": 64
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608,
          "description": "The bytes of body after the head, at most 8 MiB"
        }
      },
      "required": [
        "schema",
        "op",
        "network",
        "id",
        "name",
        "method",
        "path",
        "headers",
        "length"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "network/svc/v2"
        },
        "op": {
          "type": "string",
          "const": "window"
        },
        "network": {
          "type": "string",
          "pattern": "^net_[0-9a-f]{32}$"
        },
        "path": {
          "type": "string",
          "description": "/api/session/<id>/transcript (with cursor and limit) or /api/session/<id>/stats",
          "minLength": 1,
          "maxLength": 4096
        },
        "nonce": {
          "type": "string",
          "description": "Taken once",
          "minLength": 16,
          "maxLength": 64
        },
        "at": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991,
          "description": "When it was made (ms): within two minutes of the answering machine's clock"
        },
        "cert": {
          "type": "object",
          "properties": {
            "person": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "device": {
              "type": "string",
              "description": "The device's key id, in the person's chain",
              "minLength": 1,
              "maxLength": 128
            },
            "key": {
              "type": "object",
              "properties": {
                "alg": {
                  "type": "string",
                  "enum": [
                    "ed25519",
                    "p256"
                  ]
                },
                "key": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]*$"
                }
              },
              "required": [
                "alg",
                "key"
              ],
              "description": "The window key",
              "additionalProperties": {}
            },
            "endpoint": {
              "type": "string",
              "description": "The endpoint id of the machine whose window it is, in hex",
              "minLength": 64,
              "maxLength": 64
            },
            "at": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "When it was certified (ms)"
            },
            "until": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "When it lapses (ms), 12 hours after at, at most"
            },
            "sig": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]*$",
              "description": "The device's signature"
            }
          },
          "required": [
            "person",
            "device",
            "key",
            "endpoint",
            "at",
            "until",
            "sig"
          ],
          "additionalProperties": {}
        },
        "sig": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "description": "The window key's signature over the network, both endpoint ids, the nonce, the time and the path"
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 0,
          "description": "No body follows"
        }
      },
      "required": [
        "schema",
        "op",
        "network",
        "path",
        "nonce",
        "at",
        "cert",
        "sig",
        "length"
      ],
      "additionalProperties": {}
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "network/svc/v2"
        },
        "op": {
          "type": "string",
          "const": "answer",
          "description": "From the publishing host"
        },
        "status": {
          "type": "integer",
          "minimum": 200,
          "maximum": 599
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              {
                "type": "string",
                "maxLength": 8192
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "description": "The service's answer's headers, without Set-Cookie and hop-by-hop headers",
          "maxItems": 64
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608,
          "description": "The bytes of body after the head, at most 8 MiB"
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z-]{1,32}$",
          "description": "Set when XenoNet answered rather than the service: not-published, not-allowed, replayed, rate, path-refused, too-big, timeout…"
        }
      },
      "required": [
        "schema",
        "op",
        "status",
        "headers",
        "length"
      ],
      "additionalProperties": {}
    }
  ]
}
