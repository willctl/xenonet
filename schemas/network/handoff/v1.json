{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/network/handoff/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "A handoff",
  "description": "Work one session leaves for another, perhaps on another machine; taken by the first that accepts it.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "network/handoff/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^hof_[0-9a-f-]{36}$"
    },
    "op": {
      "type": "string",
      "enum": [
        "offer",
        "accept",
        "taken",
        "lapsed"
      ],
      "description": "offer: from the maker; accept: from a session that wants it; taken or lapsed: the maker's answer"
    },
    "from": {
      "type": "string",
      "description": "The maker, unqualified, on the entry's author's machine",
      "maxLength": 200
    },
    "to": {
      "type": "object",
      "properties": {
        "agent": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "projectKey": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 300
            },
            {
              "type": "null"
            }
          ]
        },
        "host": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,31}$",
              "description": "The host's id in the network, picked by the person: never the machine's own name"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "agent",
        "projectKey",
        "host"
      ],
      "additionalProperties": {}
    },
    "for": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "The one machine it's meant for: a handoff is a kept entry, which every member gets, and the others note it and pass it by. None: every member"
    },
    "goal": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "done": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 8000
        },
        {
          "type": "null"
        }
      ]
    },
    "next": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 8000
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      },
      "maxItems": 200
    },
    "branch": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "commit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{7,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "by": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ],
      "description": "For accept and taken: the session that took it, qualified"
    },
    "at": {
      "type": "number",
      "description": "Epoch milliseconds"
    }
  },
  "required": [
    "schema",
    "id",
    "op",
    "from",
    "to",
    "goal",
    "done",
    "next",
    "files",
    "branch",
    "commit",
    "by",
    "at"
  ],
  "additionalProperties": {}
}
