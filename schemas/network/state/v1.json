{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/network/state/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "The network, as a host sees it",
  "description": "GET /api/net/state: the network this machine is in, how it stands in it, the other hosts, and what waits.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "network/state/v1"
    },
    "network": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^net_[0-9a-f]{32}$"
            },
            "name": {
              "type": "string",
              "maxLength": 64
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ],
      "description": "null: this machine isn't in a network"
    },
    "self": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,31}$",
              "description": "The host's id in the network, picked by the person: never the machine's own name"
            },
            "keyId": {
              "type": "string",
              "pattern": "^xnk1_[a-z2-7]{32}$",
              "description": "What people compare: xnk1_ and the base32 of the first 20 bytes of the SHA-256 of both public keys"
            },
            "window": {
              "type": "boolean"
            },
            "founder": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "keyId",
            "window",
            "founder"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "link": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "off",
                "live",
                "removed"
              ]
            },
            "since": {
              "anyOf": [
                {
                  "type": "number",
                  "description": "Epoch milliseconds"
                },
                {
                  "type": "null"
                }
              ]
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 280
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "state",
            "since",
            "reason"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ],
      "description": "null: this machine isn't in a network"
    },
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "The host's id in the network, picked by the person: never the machine's own name",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "keyId": {
            "description": "What people compare: xnk1_ and the base32 of the first 20 bytes of the SHA-256 of both public keys",
            "type": "string",
            "pattern": "^xnk1_[a-z2-7]{32}$"
          },
          "window": {
            "type": "boolean"
          },
          "founder": {
            "type": "boolean"
          },
          "online": {
            "type": "boolean"
          },
          "seen": {
            "anyOf": [
              {
                "description": "Epoch milliseconds",
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "agents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "waitsOnYou": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "you": {
            "type": "boolean"
          },
          "youAt": {
            "description": "When the person last worked at its console, by this machine's clock",
            "anyOf": [
              {
                "description": "Epoch milliseconds",
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "platform": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ]
          },
          "self": {
            "description": "This machine's own row",
            "type": "boolean"
          },
          "reach": {
            "description": "Who may start and wake sessions there, as its presence said; null when its XenoNet doesn't say",
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "start": {
                "description": "Who may start sessions there: nobody, you (from a window host's console), the network (you, and the sessions and actors on window hosts), or delegate (the network, and what a session or actor starts there runs on your standing delegation, within its limits)",
                "type": "string",
                "enum": [
                  "off",
                  "you",
                  "network",
                  "delegate"
                ]
              },
              "wake": {
                "description": "Who may wake its sessions for a message: your consent per session, or any sender in the network, within the budgets",
                "type": "string",
                "enum": [
                  "consent",
                  "network"
                ]
              },
              "pending": {
                "description": "Widenings to network (or, for a start, to delegate) another window host asked for, waiting ten minutes at most for the founder or a second window host to approve",
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "setting": {
                      "type": "string",
                      "enum": [
                        "start",
                        "wake"
                      ]
                    },
                    "value": {
                      "type": "string",
                      "enum": [
                        "network",
                        "delegate"
                      ]
                    },
                    "by": {
                      "description": "The window host that asked",
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{1,31}$"
                    },
                    "at": {
                      "description": "Epoch milliseconds",
                      "type": "number"
                    }
                  },
                  "required": [
                    "id",
                    "setting",
                    "value",
                    "by",
                    "at"
                  ],
                  "additionalProperties": {}
                },
                "maxItems": 4
              },
              "delegated": {
                "description": "While start is delegate: who put the machine on it, and when",
                "type": "object",
                "properties": {
                  "by": {
                    "description": "The window host whose action put it on delegation: itself, for the person at its own keyboard",
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]{1,31}$"
                  },
                  "at": {
                    "description": "Epoch milliseconds",
                    "type": "number"
                  }
                },
                "required": [
                  "by",
                  "at"
                ],
                "additionalProperties": {}
              }
            },
            "required": [
              "start",
              "wake",
              "pending"
            ],
            "additionalProperties": {}
          },
          "can": {
            "description": "What the host's XenoNet takes beyond messages: start (a start request) and answer (an answer to a run's permission prompt). An older XenoNet says nothing",
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32
            },
            "maxItems": 16
          },
          "path": {
            "description": "How this machine reaches it on link/2: direct or relay; null while it isn't connected",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ]
          },
          "held": {
            "description": "The entries for it its mailboxes hold while it's away",
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "keyId",
          "window",
          "founder",
          "online",
          "seen",
          "agents",
          "waitsOnYou",
          "you",
          "platform"
        ],
        "additionalProperties": {}
      }
    },
    "invites": {
      "type": "object",
      "properties": {
        "open": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "description": "The host's id in the network, picked by the person: never the machine's own name",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,31}$"
              },
              "window": {
                "type": "boolean"
              },
              "expires": {
                "description": "Epoch milliseconds",
                "type": "number"
              },
              "wrong": {
                "description": "Wrong codes tried so far; five retire it",
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "host",
              "window",
              "expires",
              "wrong"
            ],
            "additionalProperties": {}
          }
        },
        "burned": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "description": "The host's id in the network, picked by the person: never the machine's own name",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,31}$"
              },
              "at": {
                "description": "Epoch milliseconds",
                "type": "number"
              },
              "retired": {
                "description": "Retired after five wrong codes; false when it ran out of time",
                "type": "boolean"
              }
            },
            "required": [
              "host",
              "at",
              "retired"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "open",
        "burned"
      ],
      "description": "The invites this machine made, while it's in a network",
      "additionalProperties": {}
    },
    "rosterHead": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]*$",
          "description": "base64url, no padding"
        },
        {
          "type": "null"
        }
      ]
    },
    "rosterMismatch": {
      "type": "array",
      "items": {
        "description": "The host's id in the network, picked by the person: never the machine's own name",
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,31}$"
      },
      "description": "Hosts whose presence shows another roster head"
    },
    "titlesOnly": {
      "type": "boolean"
    },
    "shareLoad": {
      "type": "boolean",
      "description": "Whether this machine sends its load (CPU, GPU, memory and what the parts are) to the window hosts' consoles that watch its map; on unless turned off"
    },
    "start": {
      "type": "string",
      "enum": [
        "off",
        "you",
        "network",
        "delegate"
      ],
      "description": "Who may start sessions on this machine; you unless widened"
    },
    "delegated": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "by": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "description": "The host's id in the network, picked by the person: never the machine's own name"
        },
        "at": {
          "type": "number",
          "description": "Epoch milliseconds"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "description": "While start is delegate: the window host whose action put this machine on it, and when",
      "additionalProperties": {}
    },
    "wake": {
      "type": "string",
      "enum": [
        "consent",
        "network"
      ],
      "description": "Who may wake this machine's sessions for a message; consent unless widened"
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "The entry's id, the hash of what it says apart from its signers: what POST /api/net/approve takes",
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]*$"
          },
          "op": {
            "type": "string",
            "enum": [
              "found",
              "add",
              "remove",
              "window",
              "gateway",
              "settings",
              "relays",
              "mailboxes",
              "rekey"
            ]
          },
          "host": {
            "description": "The host's id in the network, picked by the person: never the machine's own name",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "window": {
            "type": "boolean"
          },
          "signers": {
            "description": "The hosts that signed it so far",
            "type": "array",
            "items": {
              "description": "The host's id in the network, picked by the person: never the machine's own name",
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,31}$"
            }
          },
          "at": {
            "description": "Epoch milliseconds",
            "type": "number"
          }
        },
        "required": [
          "id",
          "op",
          "host",
          "window",
          "signers",
          "at"
        ],
        "additionalProperties": {}
      },
      "description": "Roster entries signed by too few, waiting for the founder or a second window host to approve them"
    },
    "removed": {
      "type": "object",
      "properties": {
        "network": {
          "type": "string",
          "pattern": "^net_[0-9a-f]{32}$"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "description": "The host's id in the network, picked by the person: never the machine's own name"
        },
        "by": {
          "type": "array",
          "items": {
            "description": "The host's id in the network, picked by the person: never the machine's own name",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$"
          },
          "description": "The hosts that signed the removal"
        },
        "at": {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        "n": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "The removal's place in the roster"
        }
      },
      "required": [
        "by",
        "at",
        "n"
      ],
      "description": "This machine was removed from the network",
      "additionalProperties": {}
    },
    "simulated": {
      "type": "boolean",
      "description": "XenoNet Dev's made-up network (simulate net-…)"
    },
    "person": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^prs_[a-z2-7]{32}$",
              "description": "A person's id: prs_ and 32 base32 characters"
            },
            {
              "type": "null"
            }
          ],
          "description": "null until an identity is set up here"
        },
        "owner": {
          "type": "boolean",
          "description": "Whether the person is the network's owner"
        },
        "device": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^xns1_[a-z2-7]{32}$",
              "description": "A signing key's id: xns1_ and 32 base32 characters"
            },
            {
              "type": "null"
            }
          ],
          "description": "This machine's device, by its key's id; null where it has no way to ask the person"
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "biometric",
                "weaker"
              ],
              "description": "How a device asks the person before it signs: biometric (Touch ID), or weaker (Windows Hello, polkit or a passphrase)"
            },
            {
              "type": "null"
            }
          ]
        },
        "acts": {
          "type": "boolean",
          "description": "Whether this machine's device is an active device of the person's, so it can act as them"
        },
        "rootSealed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the person's root key is sealed to this machine's device key (false: in an owner-only file); null where this machine doesn't hold it"
        },
        "devices": {
          "type": "array",
          "items": {
            "description": "One of the person's devices, as their chain holds it",
            "type": "object",
            "properties": {
              "id": {
                "description": "A signing key's id: xns1_ and 32 base32 characters",
                "type": "string",
                "pattern": "^xns1_[a-z2-7]{32}$"
              },
              "label": {
                "description": "The machine it was paired on, as the person named it then",
                "type": "string",
                "maxLength": 64
              },
              "kind": {
                "description": "How a device asks the person before it signs: biometric (Touch ID), or weaker (Windows Hello, polkit or a passphrase)",
                "type": "string",
                "enum": [
                  "biometric",
                  "weaker"
                ]
              },
              "active": {
                "description": "Whether it can sign: false once it was removed or revoked",
                "type": "boolean"
              },
              "here": {
                "description": "Whether it's this machine's own device",
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "label",
              "kind",
              "active",
              "here"
            ],
            "additionalProperties": {}
          },
          "description": "The person's devices, every one their chain holds"
        }
      },
      "required": [
        "id",
        "owner",
        "device",
        "kind",
        "acts",
        "rootSealed"
      ],
      "description": "Who this machine acts as, while it's in a network",
      "additionalProperties": {}
    },
    "frozen": {
      "type": "array",
      "items": {
        "description": "A member's feed that froze here: it signed two entries at one place",
        "type": "object",
        "properties": {
          "author": {
            "description": "The member, by its machine signing key",
            "type": "string",
            "pattern": "^xns1_[a-z2-7]{32}$"
          },
          "host": {
            "description": "The member's host id, while the network's chain lists it",
            "anyOf": [
              {
                "description": "The host's id in the network, picked by the person: never the machine's own name",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,31}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "description": "Where the two entries are",
            "type": "object",
            "properties": {
              "inc": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "inc",
              "seq"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "author",
          "host",
          "at"
        ],
        "additionalProperties": {}
      },
      "description": "Members' feeds a fork froze here: nothing from them is taken until you unfreeze one at the window"
    }
  },
  "required": [
    "schema",
    "network",
    "self",
    "link",
    "hosts",
    "rosterHead",
    "rosterMismatch",
    "titlesOnly"
  ],
  "additionalProperties": {}
}
