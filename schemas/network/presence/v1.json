{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/network/presence/v1.json",
  "$comment": "Written by npm run schemas from core/schema. Change the definition there, not this file.",
  "title": "A host's presence",
  "description": "Which agents are on a host, what each is doing, and whether the person is there.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "network/presence/v1"
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Grows with every presence a host sends; a receiver drops one older than the newest it has"
    },
    "full": {
      "type": "boolean",
      "description": "true: every agent on the host; false: only the agents listed changed, and removed went"
    },
    "agents": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "The agent's id on its own host (claude:<uuid>, codex:<id>, actor:<slug>): receivers qualify it as @<host>:<id>"
          },
          "app": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "description": "What the live state says: working, waiting, idle…"
          },
          "doing": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 280
              },
              {
                "type": "null"
              }
            ],
            "description": "What it said it's doing (focus)"
          },
          "repoKey": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "description": "The normalized git remote of its folder (origin, else the first remote), or null when it has none"
          },
          "branch": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "cwd": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "description": "Its folder, with the home folder as ~"
          },
          "lastActive": {
            "anyOf": [
              {
                "type": "number",
                "description": "Epoch milliseconds"
              },
              {
                "type": "null"
              }
            ]
          },
          "waitsOnYou": {
            "type": "boolean",
            "description": "A question or a stuck state waits on the person"
          },
          "question": {
            "description": "While it waits on the person: the text of its question, or of the permission it asks for, with the home folder as ~",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 320
              },
              {
                "type": "null"
              }
            ]
          },
          "lastMessage": {
            "description": "What it said last, its last 280 characters, with the home folder as ~",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 280
              },
              {
                "type": "null"
              }
            ]
          },
          "stuck": {
            "description": "Why it seems stuck, with the home folder as ~",
            "anyOf": [
              {
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 280
                }
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "app",
          "title",
          "state",
          "doing",
          "repoKey",
          "branch",
          "cwd",
          "lastActive",
          "waitsOnYou"
        ],
        "additionalProperties": {}
      }
    },
    "removed": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "description": "Agents that went since the last presence"
    },
    "you": {
      "type": "boolean",
      "description": "The person's last input was in this host's console: they're here"
    },
    "youAt": {
      "description": "When the person last worked at this host's console (input in the last two minutes), to the half minute, by the gateway's clock: the consoles chime only where it's latest, or everywhere once it's five minutes old",
      "anyOf": [
        {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        {
          "type": "null"
        }
      ]
    },
    "roster": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$",
      "description": "The hash of the sender's roster head, so hosts that see different rosters notice"
    }
  },
  "required": [
    "schema",
    "counter",
    "full",
    "agents",
    "removed",
    "you",
    "roster"
  ],
  "additionalProperties": {}
}
