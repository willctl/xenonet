{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/network/presence/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "A host's presence",
  "description": "Which agents are on a host, what each is doing, and whether the person is there.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "network/presence/v1"
    },
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Grows with every presence a host sends; a receiver drops one older than the newest it has"
    },
    "full": {
      "type": "boolean",
      "description": "true: every agent on the host; false: only the agents listed changed, and removed went"
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "The agent's id on its own host (claude:<uuid>, codex:<id>, actor:<slug>): receivers qualify it as @<host>:<id>",
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "app": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ]
          },
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "description": "What the live state says: working, waiting, idle…",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ]
          },
          "doing": {
            "description": "What it said it's doing (focus)",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 280
              },
              {
                "type": "null"
              }
            ]
          },
          "repoKey": {
            "description": "The normalized git remote of its folder (origin, else the first remote), or null when it has none",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "branch": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "cwd": {
            "description": "Its folder, with the home folder as ~",
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "lastActive": {
            "anyOf": [
              {
                "description": "Epoch milliseconds",
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "waitsOnYou": {
            "description": "A question or a stuck state waits on the person",
            "type": "boolean"
          },
          "question": {
            "description": "While it waits on the person: the text of its question, or of the permission it asks for, with the home folder as ~",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 320
          },
          "lastMessage": {
            "description": "What it said last, its last 280 characters, with the home folder as ~",
            "type": [
              "string",
              "null"
            ],
            "maxLength": 280
          },
          "stuck": {
            "description": "Why it seems stuck, with the home folder as ~",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "maxLength": 280
            },
            "maxItems": 8
          }
        },
        "required": [
          "id",
          "app",
          "title",
          "state",
          "doing",
          "repoKey",
          "branch",
          "cwd",
          "lastActive",
          "waitsOnYou"
        ],
        "additionalProperties": {}
      },
      "maxItems": 1000
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "description": "Agents that went since the last presence",
      "maxItems": 1000
    },
    "you": {
      "type": "boolean",
      "description": "The person's last input was in this host's console: they're here"
    },
    "youAt": {
      "anyOf": [
        {
          "type": "number",
          "description": "Epoch milliseconds"
        },
        {
          "type": "null"
        }
      ],
      "description": "When the person last worked at this host's console (input in the last two minutes), to the half minute, by the gateway's clock: the consoles chime only where it's latest, or everywhere once it's five minutes old"
    },
    "roster": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]*$",
      "description": "The hash of the sender's roster head, so hosts that see different rosters notice"
    },
    "reach": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "enum": [
            "off",
            "you",
            "network",
            "delegate"
          ],
          "description": "Who may start sessions there: nobody, you (from a window host's console), the network (you, and the sessions and actors on window hosts), or delegate (the network, and what a session or actor starts there runs on your standing delegation, within its limits)"
        },
        "wake": {
          "type": "string",
          "enum": [
            "consent",
            "network"
          ],
          "description": "Who may wake its sessions for a message: your consent per session, or any sender in the network, within the budgets"
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "setting": {
                "type": "string",
                "enum": [
                  "start",
                  "wake"
                ]
              },
              "value": {
                "type": "string",
                "enum": [
                  "network",
                  "delegate"
                ]
              },
              "by": {
                "description": "The window host that asked",
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{1,31}$"
              },
              "at": {
                "description": "Epoch milliseconds",
                "type": "number"
              }
            },
            "required": [
              "id",
              "setting",
              "value",
              "by",
              "at"
            ],
            "additionalProperties": {}
          },
          "description": "Widenings to network (or, for a start, to delegate) another window host asked for, waiting ten minutes at most for the founder or a second window host to approve",
          "maxItems": 4
        },
        "delegated": {
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,31}$",
              "description": "The window host whose action put it on delegation: itself, for the person at its own keyboard"
            },
            "at": {
              "type": "number",
              "description": "Epoch milliseconds"
            }
          },
          "required": [
            "by",
            "at"
          ],
          "description": "While start is delegate: who put the machine on it, and when",
          "additionalProperties": {}
        }
      },
      "required": [
        "start",
        "wake",
        "pending"
      ],
      "additionalProperties": {}
    },
    "can": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 32
      },
      "description": "What the host's XenoNet takes beyond messages: start (a start request) and answer (an answer to a run's permission prompt). An older XenoNet says nothing",
      "maxItems": 16
    }
  },
  "required": [
    "schema",
    "counter",
    "full",
    "agents",
    "removed",
    "you",
    "roster"
  ],
  "additionalProperties": {}
}
