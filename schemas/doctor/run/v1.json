{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/doctor/run/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "A doctor run",
  "description": "Every check the doctor ran, and how many came out each way.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "doctor/run/v1",
      "description": "In doctor.json"
    },
    "at": {
      "type": "number",
      "description": "Epoch milliseconds"
    },
    "ms": {
      "type": "number"
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "https://xenonet.dev/schemas/doctor/result/v1.json"
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "info": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "warn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fail": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skip": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ok",
        "info",
        "warn",
        "fail",
        "skip"
      ],
      "additionalProperties": {}
    },
    "by": {
      "type": [
        "string",
        "null"
      ],
      "description": "Which XenoNet ran it, when the xenonet command asked one; null when it ran in the command itself"
    }
  },
  "required": [
    "at",
    "ms",
    "results",
    "summary"
  ],
  "additionalProperties": {}
}
