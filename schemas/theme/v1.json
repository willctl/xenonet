    },
    "builtIn": {
      "type": "boolean"
    },
    "replacesBuiltIn": {
      "type": "boolean",
      "description": "A theme of yours with a built-in's id: it takes that one's place"
    },
    "extends": {
      "type": "string",
      "description": "The theme it starts from; xenonet when left out"
    },
