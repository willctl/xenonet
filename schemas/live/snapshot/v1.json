          "titles": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": false
          }
        },
        "required": [
          "a",
          "b",
          "files",
          "paths",
          "ts",
          "branches",
          "sameBranch",
          "titles"
        ],
        "additionalProperties": {}
      },
      "description": "Sessions on the map that both edited a file in the last ten minutes"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "server": {
            "type": "string"
          },
          "ts": {
            "description": "Epoch milliseconds",
            "type": "number"
          },
          "name": {
            "description": "What an MCP server with a uuid for an id is called: its name in Claude desktop, or what its instructions or results say",
            "type": "string"
          },
          "nameSource": {
            "description": "Where the name came from: Claude desktop's list of connectors, or the server's own instructions or results",
            "type": "string",
            "enum": [
              "declared",
              "instructions",
              "results"
            ]
          }
        },
        "required": [
          "server",
          "ts"
        ],
        "additionalProperties": {}
      },
      "maxItems": 8
