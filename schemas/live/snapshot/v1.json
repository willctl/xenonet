    "status": {
      "type": "object",
      "properties": {
        "watching": {
          "type": "boolean"
        },
        "files": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "errors": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "watching",
        "files",
        "lines",
        "errors"
      ],
      "additionalProperties": {}
