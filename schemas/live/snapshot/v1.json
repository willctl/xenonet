    "costs": {
      "type": "object",
      "properties": {
        "today": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Dollars; null when no call today has a price, so what it cost isn't known"
        },
        "byApp": {
          "type": "object",
          "properties": {
            "claude": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dollars; null when the app's calls today have no price"
            },
            "codex": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dollars; null when the app's calls today have no price"
            },
            "grok": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Dollars; null when the app's calls today have no price"
            }
          },
          "required": [
            "claude",
            "codex",
            "grok"
          ],
          "additionalProperties": {}
        },
        "perHour": {
          "type": "number",
          "description": "Dollars an hour at this minute's pace"
        },
        "unpriced": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Models used today with no price: none in XenoNet's table, and none their app said"
        },
        "checked": {
          "type": "string",
          "description": "When the prices were last checked against the providers' (YYYY-MM-DD)"
        }
      },
      "required": [
        "today",
        "byApp",
        "perHour",
        "unpriced",
        "checked"
      ],
      "description": "What today's calls would cost at API prices (core/pricing.js), or at what their app said they cost (Grok Build's), in dollars",
      "additionalProperties": {}
