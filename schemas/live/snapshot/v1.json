{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/live/snapshot/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "Live state",
  "description": "What the agents are doing now: each session's live state, token rates, plan usage and its forecast, and the sessions working on the same files.",
  "type": "object",
  "properties": {
    "at": {
      "type": "number",
      "description": "Epoch milliseconds"
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "https://xenonet.dev/schemas/live/session/v1.json"
      },
      "description": "Sessions with anything in the last 24 hours"
    },
    "series": {
      "type": "object",
      "properties": {
        "claude": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "codex": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "grok": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "claude",
        "codex",
        "grok"
      ],
      "description": "Tokens a second over the last five minutes, oldest first",
      "additionalProperties": {}
    },
    "tpm": {
      "type": "number"
    },
    "total24h": {
      "type": "number"
    },
    "today": {
      "type": "number"
    },
    "limits": {
      "type": "object",
      "properties": {
        "codex": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "primary": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "pct": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Used, 0 to 100"
                        },
                        "windowMinutes": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "How long the window is"
                        },
                        "resetsAt": {
                          "anyOf": [
                            {
                              "type": "number",
                              "description": "Epoch milliseconds"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "When it resets"
                        }
                      },
                      "required": [
                        "pct",
                        "windowMinutes",
                        "resetsAt"
                      ],
                      "additionalProperties": {}
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "secondary": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "pct": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Used, 0 to 100"
                        },
                        "windowMinutes": {
                          "anyOf": [
                            {
                              "type": "number"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "How long the window is"
                        },
                        "resetsAt": {
                          "anyOf": [
                            {
                              "type": "number",
                              "description": "Epoch milliseconds"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "When it resets"
                        }
                      },
                      "required": [
                        "pct",
                        "windowMinutes",
                        "resetsAt"
                      ],
                      "additionalProperties": {}
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "observedAt": {
                  "type": "number",
                  "description": "Epoch milliseconds"
                },
                "identity": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The identity it was read for (claude:…, chatgpt:…, openai:api-key), the one signed in now; null when XenoNet doesn't know it"
                },
                "host": {
                  "type": "string",
                  "description": "The host it was read on, when that's another machine"
                }
              },
              "required": [
                "primary",
                "secondary",
                "observedAt"
              ],
              "additionalProperties": {}
            },
            {
              "type": "null"
            }
          ],
          "description": "Codex's rate limits, as its last token count reported them, and when"
        },
        "claude": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "fiveHour": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sevenDay": {
                      "anyOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "resets": {
                      "type": "object",
                      "properties": {
                        "fiveHour": {
                          "anyOf": [
                            {
                              "type": "number",
                              "description": "Epoch milliseconds"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "sevenDay": {
                          "anyOf": [
                            {
                              "type": "number",
                              "description": "Epoch milliseconds"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "additionalProperties": {}
                    },
                    "observedAt": {
                      "type": "number",
                      "description": "Epoch milliseconds"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "anthropic",
                        "claude-desktop"
                      ]
                    },
                    "identity": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The identity it was read for (claude:…, chatgpt:…, openai:api-key), the one signed in now; null when XenoNet doesn't know it"
                    },
                    "host": {
                      "type": "string",
                      "description": "The host it was read on, when that's another machine"
                    }
                  },
                  "required": [
                    "fiveHour",
                    "sevenDay",
                    "resets",
                    "observedAt",
                    "source"
                  ],
                  "additionalProperties": {}
                },
                {
                  "type": "object",
                  "properties": {
                    "fiveHour": {
                      "type": "null"
                    },
                    "sevenDay": {
                      "type": "null"
                    },
                    "observedAt": {
                      "anyOf": [
                        {
                          "type": "number",
                          "description": "Epoch milliseconds"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "stale": {
                      "type": "boolean",
                      "const": true
                    },
                    "reason": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "identity": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The identity it was read for (claude:…, chatgpt:…, openai:api-key), the one signed in now; null when XenoNet doesn't know it"
                    },
                    "host": {
                      "type": "string",
                      "description": "The host it was read on, when that's another machine"
                    }
                  },
                  "required": [
                    "fiveHour",
                    "sevenDay",
                    "observedAt",
                    "stale",
                    "reason"
                  ],
                  "description": "No reading recent enough: when the last one was, and why there's none since",
                  "additionalProperties": {}
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Claude plan usage, in percent"
        },
        "others": {
          "type": "array",
