              "description": "When it runs out at this pace"
            },
            "resetsAt": {
              "anyOf": [
                {
                  "type": "number",
                  "description": "Epoch milliseconds"
                },
                {
                  "type": "null"
                }
              ]
            },
            "hitsBeforeReset": {
              "type": "boolean"
            },
            "windowMinutes": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "additionalProperties": {}
        },
        "claudeFiveHour": {
          "type": [
            "object",
            "null"
