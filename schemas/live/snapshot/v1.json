              "host": {
                "type": "string"
              },
              "reading": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              }
            },
            "required": [
              "app",
              "identity",
              "host",
              "reading"
            ],
            "additionalProperties": {}
          },
          "description": "With hosts on: readings of accounts signed in only on other machines, the newest of each, as limits.claude and limits.codex have them"
        }
      },
      "required": [
        "codex",
        "claude"
