          "properties": {
            "pct": {
              "type": "number",
              "description": "Used, 0 to 100"
            },
            "perHour": {
              "type": "number"
            },
            "eta": {
              "anyOf": [
                {
                  "type": "number",
                  "description": "Epoch milliseconds"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When it runs out at this pace"
            },
            "resetsAt": {
              "anyOf": [
                {
                  "type": "number",
                  "description": "Epoch milliseconds"
                },
                {
                  "type": "null"
                }
              ]
            },
            "hitsBeforeReset": {
              "type": "boolean"
            }
          },
          "required": [
            "pct",
            "perHour",
            "eta",
            "resetsAt",
            "hitsBeforeReset"
          ],
          "additionalProperties": {}
        },
        "claudeSevenDay": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "pct": {
              "type": "number",
              "description": "Used, 0 to 100"
            },
            "perHour": {
              "type": "number"
            },
            "eta": {
              "anyOf": [
                {
                  "type": "number",
                  "description": "Epoch milliseconds"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When it runs out at this pace"
            },
            "resetsAt": {
              "anyOf": [
                {
                  "type": "number",
                  "description": "Epoch milliseconds"
                },
                {
                  "type": "null"
                }
              ]
            },
            "hitsBeforeReset": {
              "type": "boolean"
            }
          },
          "required": [
            "pct",
            "perHour",
            "eta",
            "resetsAt",
            "hitsBeforeReset"
          ],
          "additionalProperties": {}
        }
      },
      "additionalProperties": {}
