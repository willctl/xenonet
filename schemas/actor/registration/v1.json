{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/actor/registration/v1.json",
  "$comment": "Written by npm run schemas from core/schema. Change the definition there, not this file.",
  "title": "Registering an actor",
  "description": "What a program sends to POST /api/actors/register to ask to be an actor. It's answered at once, and its token works once you allow it in XenoNet's window.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "actor/registration/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "slug": {
      "description": "Without one, XenoNet makes one from the name",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "product": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "vendor": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "spawn-sessions",
              "edit-repos",
              "run-commands",
              "message-people",
              "message-agents",
              "schedule",
              "browse",
              "use-computer"
            ]
          },
          {
            "type": "string"
          }
        ]
      }
    },
    "heartbeatMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "pid": {
      "description": "Its process, which XenoNet checks on macOS",
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": {}
}
