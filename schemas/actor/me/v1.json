{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/actor/me/v1.json",
  "$comment": "Written by npm run schemas from core/schema. Change the definition there, not this file.",
  "title": "An actor, as it sees itself",
  "description": "The answer to an actor's own calls (GET /api/actors/me, and its reports) and to the person's reports: whether it's allowed, its presence, its unread messages, and what XenoNet took.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "actor/me/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^(@[a-z][a-z0-9-]{1,31}:)?actor:[a-z0-9][a-z0-9-]{0,31}$",
      "description": "actor:<slug>, or @<host>:actor:<slug> from another host; the person at the console is actor:you"
    },
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "waiting",
            "allowed"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "presence": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "working",
            "idle",
            "away",
            "offline",
            "unknown"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "heartbeatMs": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "unread": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Engine messages waiting for it"
    },
    "accepted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dropped": {
      "description": "The parts of the report XenoNet left out, and why",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "index",
          "reason"
        ],
        "additionalProperties": {}
      }
    }
  },
  "required": [
    "schema",
    "id",
    "state",
    "presence",
    "heartbeatMs",
    "unread"
  ],
  "additionalProperties": {}
}
