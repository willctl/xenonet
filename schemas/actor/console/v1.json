{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/actor/console/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "The person at the console",
  "description": "What XenoNet's own window reports of you to POST /api/actors/you, with the key only the window holds: your presence, and what you did as node ids and action names. Never what you type.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "actor/console/v1"
    },
    "presence": {
      "type": "string",
      "enum": [
        "working",
        "idle",
        "away"
      ]
    },
    "did": {
      "type": "array",
      "items": {
        "description": "Something you did, as a node id and an action's name: never text",
        "type": "object",
        "properties": {
          "what": {
            "description": "looked: a selection that held 3 s; read: a preview or stats; opened: in its app; handed-off and started: a session; terminal: one opened in a folder",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "looked",
                  "read",
                  "opened",
                  "handed-off",
                  "started",
                  "terminal"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "node": {
            "description": "The graph node it was done to",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "at": {
            "description": "Epoch milliseconds",
            "type": "number"
          },
          "to": {
            "description": "For handed-off: the app it went to",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "claude",
                  "codex"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "app": {
            "description": "For started: the app the session starts in",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "claude",
                  "codex"
                ]
              },
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "what",
          "node"
        ],
        "additionalProperties": {}
      },
      "maxItems": 20
    }
  },
  "additionalProperties": {}
}
