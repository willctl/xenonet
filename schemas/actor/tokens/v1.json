{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xenonet.dev/schemas/actor/tokens/v1.json",
  "$comment": "Written from crates/xenonet-model by cargo test -p xenonet-model. Change the type there, not this file.",
  "title": "Registered actors' tokens",
  "description": "What GET /api/actors/tokens answers XenoNet's own window, with its key: for each actor that reports itself, whether its token works, when it expires unless it's used, and when it was last used. Never a token, nor its hash.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "actor/tokens/v1"
    },
    "at": {
      "type": "number",
      "description": "Epoch milliseconds"
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actor": {
            "description": "An actor that reports itself",
            "type": "string",
            "pattern": "^actor:[a-z0-9][a-z0-9-]{0,31}$"
          },
          "state": {
            "description": "works; expired: 30 days unused, until you give it a new token; none: the demo's made-up actor has none",
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "works",
                  "expired",
                  "none"
                ]
              },
              {
                "type": "string"
              }
            ]
          },
          "expiresAt": {
            "description": "When it stops working unless it's used before then; null unless it works",
            "anyOf": [
              {
                "description": "Epoch milliseconds",
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "usedAt": {
            "description": "When it was last used: exactly the first time, and to within the hour after that; null for a token never used, or none",
            "anyOf": [
              {
                "description": "Epoch milliseconds",
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "gateway": {
            "description": "Its gateway token, while it has one that works (server/actor-gateway.js)",
            "type": "object",
            "properties": {
              "state": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "works"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "expiresAt": {
                "description": "When it stops working unless it's used before then",
                "type": "number"
              },
              "usedAt": {
                "description": "When it was last used, to within the hour; null for one never used",
                "anyOf": [
                  {
                    "description": "Epoch milliseconds",
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "state",
              "expiresAt",
              "usedAt"
            ],
            "additionalProperties": {}
          },
          "allows": {
            "description": "What it may Allow of the permission prompts it answers, when it has an allow scope: PUT /api/actors/<slug>/allows sets it from the window, DELETE ends it",
            "type": "object",
            "properties": {
              "sessions": {
                "description": "The sessions an allow scope covers: every session here, or these.",
                "anyOf": [
                  {
                    "type": "string",
                    "const": "all"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                ]
              },
              "kinds": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "read",
                        "edit",
                        "command",
                        "web",
                        "tool"
                      ]
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "until": {
                "description": "When it ends",
                "type": "number"
              }
            },
            "required": [
              "sessions",
              "kinds",
              "until"
            ],
            "additionalProperties": {}
          }
        },
        "required": [
          "actor",
          "state",
          "expiresAt",
          "usedAt"
        ],
        "additionalProperties": {}
      },
      "description": "Oldest actor first"
    }
  },
  "required": [
    "schema",
    "at",
    "tokens"
  ],
  "additionalProperties": {}
}
